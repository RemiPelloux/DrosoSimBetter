# Copiez ce fichier en .env.local puis adaptez-le. Les variables SIM_* sont lues au build (npm run build).

# Backend de simulation : local (moteur du navigateur, par défaut) | http | ws
SIM_BACKEND=local

# URL du backend si SIM_BACKEND vaut http ou ws
# SIM_BACKEND_URL=http://localhost:8788/simulate
