# Copiez ce fichier en .env.local puis adaptez-le. Les variables NEXT_PUBLIC_* sont lues au build.

# Backend de simulation : local (moteur du navigateur, par défaut) | http | ws
NEXT_PUBLIC_SIM_BACKEND=local

# URL du backend si NEXT_PUBLIC_SIM_BACKEND vaut http ou ws
# NEXT_PUBLIC_SIM_BACKEND_URL=http://localhost:8788/simulate
