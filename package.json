{
  "name": "drososim-next",
  "version": "1.0.0",
  "private": true,
  "description": "Simulateur d’aide à la décision pour la protection intégrée des vergers de cerisiers contre Drosophila suzukii",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ng serve",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:engine": "node scripts/test-engine.ts",
    "test:e2e": "node scripts/with-server.mjs scripts/test-e2e.mjs",
    "test": "npm run test:engine && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test:engine",
    "docs:media": "node scripts/with-server.mjs scripts/docs-media.mjs",
    "backend:node": "node examples/backend-node/server.ts",
    "backend:python": "python3 examples/backend-python/server.py"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "cn": "^0.5.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^14.7.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lucide": "1.62.0",
    "lz-string": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "unified": "^11.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "eslint": "^9",
    "playwright-core": "1.57",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
