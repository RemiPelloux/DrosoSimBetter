{
  "name": "drososim-next",
  "version": "1.0.0",
  "private": true,
  "description": "Simulateur d’aide à la décision pour la protection intégrée des vergers de cerisiers contre Drosophila suzukii",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:engine": "node scripts/test-engine.ts",
    "test:e2e": "node scripts/with-server.mjs scripts/test-e2e.mjs",
    "test": "npm run test:engine && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test:engine",
    "docs:media": "node scripts/with-server.mjs scripts/docs-media.mjs",
    "backend:node": "node examples/backend-node/server.ts",
    "backend:python": "python3 examples/backend-python/server.py"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "framer-motion": "^14.7.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "lz-string": "^1.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "1.57",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
